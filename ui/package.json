{
  "type": "module",
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "rsbuild build",
    "dev": "rsbuild build --watch --env-mode=development",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "prettier": "prettier --write src/",
    "test:unit": "vitest --passWithNoTests",
    "type-check": "vue-tsc --build"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "dependencies": {
    "@halo-dev/api-client": "^2.22.0",
    "@halo-dev/components": "^2.22.0",
    "@halo-dev/ui-shared": "^2.22.0",
    "@tanstack/vue-query": "4",
    "axios": "^1.13.2",
    "file-saver": "^2.0.5",
    "monaco-editor": "^0.54.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@halo-dev/ui-plugin-bundler-kit": "^2.24.0",
    "@iconify-json/mingcute": "^1.2.7",
    "@rsbuild/core": "^2.0.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.12.4",
    "@vitest/eslint-plugin": "^1.4.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.1",
    "eslint-plugin-oxlint": "^1.28.0",
    "eslint-plugin-vue": "~10.0.1",
    "jsdom": "^26.1.0",
    "monaco-editor-webpack-plugin": "^7.1.0",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^1.28.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~5.8.3",
    "unplugin-icons": "^22.5.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.2"
  },
  "packageManager": "pnpm@10.22.0"
}
